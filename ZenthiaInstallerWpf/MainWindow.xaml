<Window x:Class="ZenthiaInstallerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programa de instalación de Zenthia - Instalación de LiquidAR"
        Height="320" Width="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LinkButton" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1a73e8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style x:Key="InstallButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo: imagen -->
        <Border Grid.Column="0">
            <Border.Background>
                <ImageBrush ImageSource="Assets/apple.jpg" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <!-- Panel derecho: contenido -->
        <Grid Grid.Column="1" Margin="28,28,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding ProductTitle}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#2b2b2b"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ProductSubtitle}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#2b2b2b"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Progreso / estado (oculto hasta que empieza la instalación) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom"
                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding CurrentPackage}" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                <ProgressBar Height="6" Minimum="0" Maximum="100"
                             Value="{Binding OverallProgress, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Al instalar acepta " Foreground="#555"/>
                <TextBlock Text="términos y condiciones"
                           Style="{StaticResource LinkButton}"
                           MouseLeftButtonUp="TerminosYCondiciones_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Instalar" Width="100" Height="32"
                        Style="{StaticResource InstallButton}"
                        Command="{Binding InstallCommand}"
                        Margin="0,0,10,0"/>
                <Button Content="Cerrar" Width="90" Height="32"
                        Style="{StaticResource CloseButton}"
                        Click="Cerrar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
