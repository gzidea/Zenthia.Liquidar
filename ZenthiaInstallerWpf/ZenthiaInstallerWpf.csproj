<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!--
    Ajustá esta ruta a donde tengas instalado el SDK de WiX v3
    (normalmente: C:\Program Files (x86)\WiX Toolset v3.11\SDK\)
  -->
  <PropertyGroup>
    <WixSdkPath>C:\Program Files (x86)\WiX Toolset v3.14\SDK\</WixSdkPath>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7E3C6E3B-7B1B-4B7A-9C4E-1A2B3C4D5E6F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ZenthiaInstallerWpf</RootNamespace>
    <AssemblyName>ZenthiaInstallerWpf</AssemblyName>
    <TargetFrameworkVersion>v4.6</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WarningLevel>4</WarningLevel>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xaml">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <!-- API administrada del Bootstrapper (Burn) que trae el SDK de WiX v3 -->
    <Reference Include="BootstrapperCore">
      <HintPath>$(WixSdkPath)BootstrapperCore.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Deployment.WindowsInstaller">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(WixSdkPath)Microsoft.Deployment.WindowsInstaller.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="BootstrapperApp.cs" />
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="ViewModels\MainViewModel.cs" />
    <Compile Include="ViewModels\RelayCommand.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\apple.jpg" />
  </ItemGroup>
  <ItemGroup>
    <!-- Este .config se renombra en la salida a "ZenthiaInstallerWpf.BootstrapperCore.config"
         y es el archivo que le indica al host cuál es tu ensamblado y clase -->
    <None Include="BootstrapperCore.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Renombra el .config de salida al patrón que exige el host de WiX -->
  <Target Name="AfterBuild">
    <Copy SourceFiles="$(OutputPath)BootstrapperCore.config" DestinationFiles="$(OutputPath)$(AssemblyName).BootstrapperCore.config" />
  </Target>
</Project>