          <EntitySet Name="Liquidaciones" EntityType="Self.Liquidaciones" store:Type="Tables" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [Liquidaciones].[Id] AS [Id], 
    [Liquidaciones].[IdLegajo] AS [IdLegajo], 
    [Liquidaciones].[IdTipoLiquidacion] AS [IdTipoLiquidacion], 
    [Liquidaciones].[Periodo] AS [Periodo], 
    [Liquidaciones].[Fecha] AS [Fecha], 
    [Liquidaciones].[Generado] AS [Generado], 
    [Liquidaciones].[Impreso] AS [Impreso], 
    [Liquidaciones].[TotalRemunerativo] AS [TotalRemunerativo], 
    [Liquidaciones].[TotalNoRemunerativo] AS [TotalNoRemunerativo], 
    [Liquidaciones].[TotalDescuento] AS [TotalDescuento], 
    [Liquidaciones].[Jubilacion] AS [Jubilacion], 
    [Liquidaciones].[Sindicato] AS [Sindicato], 
    [Liquidaciones].[ObraSocial] AS [ObraSocial]
    FROM [dbo].[Liquidaciones] AS [Liquidaciones]</DefiningQuery>
